# Copie para .env (que está no .gitignore). Nunca commite chaves.
# Sem estas variáveis a demo roda mesmo assim: redator padrão (sem LLM) e sem rastreio.
# Se o .env do agents não tiver uma variável, a demo lê a do .env do artemishub_rag.

# LLM da Análise (endpoint compatível com OpenAI; os mesmos nomes do artemishub_rag)
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Langfuse (Settings > API Keys no projeto). EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Label do prompt da Análise no Langfuse (o texto do prompt não fica no repo)
LANGFUSE_PROMPT_LABEL=production

# Onde está o artemishub_rag (padrão: ../artemishub_rag). Numa worktree, aponte para o submódulo do orquestrador.
# Índice do RAG (padrão: o .chroma de ARTEMIS_RAG_DIR). Gere com `python -m artemis_rag.pipeline` no rag.
# ARTEMIS_RAG_INDEX_DIR=
# ARTEMIS_RAG_DIR=../artemishub_orchestration/artemishub_rag
# Use 1 para consultar um índice parcial (diagnóstico).
# ARTEMIS_RAG_PARCIAL=0
